# TOUCHGRASS Environment Configuration

# Optional: MongoDB Atlas connection string (Falls back to local offline JSON storage if omitted)
MONGODB_URI=

# Optional: ElevenLabs API Key for spoken voice agent (Falls back to browser Web Speech API if omitted)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional: Sentry DSN for Agent Tracing & Observability
SENTRY_DSN=

# Optional: Ollama / Local Gemma endpoint (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma-2-9b-it

# Simulation / Offline Airplane mode (true/false)
OFFLINE_MODE=false
